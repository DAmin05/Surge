# Copy to .env to override. Every value has a dev default in the compose files, so
# `docker compose up` works without this file. Never commit a real .env.

# Postgres admin (bootstrap migration only) and per-service roles
POSTGRES_DB=surge
POSTGRES_ADMIN_USER=surge_admin
POSTGRES_ADMIN_PASSWORD=surge_admin_dev
ORDERS_OWNER_PASSWORD=orders_owner_dev
ORDERS_APP_PASSWORD=orders_app_dev
PAYMENTS_OWNER_PASSWORD=payments_owner_dev
PAYMENTS_APP_PASSWORD=payments_app_dev
RECONCILER_PASSWORD=reconciler_dev

# Sale tuning (ISO-8601 durations)
HOLD_LEASE=PT5M
PAYMENT_TIMEOUT=PT2M
PIN_GRACE=PT30S
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
RECONCILER_CHECK_INTERVAL=PT5S
ADMIT_RATE_PER_SEC=200
KAFKA_PARTITIONS=12

# Images
REGISTRY=surge
TAG=dev

GRAFANA_ADMIN_PASSWORD=admin
